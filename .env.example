# Copy to .env.local for local development. Never commit real values.

# Public production URL (no trailing slash). Used for canonical URLs, sitemap,
# robots.txt, social previews, and the contact form's origin check.
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Contact form email delivery (Resend: https://resend.com) ---
# All three are required. Without them the form refuses submissions and says so.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Inbox that receives inquiries (comma-separate for multiple).
CONTACT_TO_EMAIL=inbox@example.com
# Sender on a domain you have verified in Resend, e.g. "Lami Ventures <website@yourdomain.com>".
CONTACT_FROM_EMAIL="Lami Ventures Website <website@example.com>"

# --- Rate limiting (recommended in production; Upstash Redis: https://upstash.com) ---
# Without these, an in-memory limiter is used, which is per-instance and best effort only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Random string used to hash IP addresses before rate limiting. Generate with: openssl rand -hex 32
RATE_LIMIT_SALT=
